{
  "expo": {
    "name": "Kine",
    "slug": "kine-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kine.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#172121"
      },
      "package": "com.kine.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#172121"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "14dd24d2-dc56-4838-8586-f3726509abe4"
      }
    }
  }
}