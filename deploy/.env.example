# PostgreSQL container
POSTGRES_USER=kine
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=kine

# API connection string to PostgreSQL service in compose
DATABASE_URL=postgresql+asyncpg://kine:change-me-strong@db:5432/kine

# API application settings
ENVIRONMENT=production
SECRET_KEY=replace-with-a-strong-random-secret
ADMIN_API_KEY=replace-with-a-strong-admin-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.kine.local

# Host port published by the API container
PUBLISHED_API_PORT=8000
