# PostgreSQL container
POSTGRES_USER=egt
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=egt

# API connection string to PostgreSQL service in compose
DATABASE_URL=postgresql+asyncpg://egt:change-me-strong@db:5432/egt

# API application settings
ENVIRONMENT=production
SECRET_KEY=replace-with-a-strong-random-secret
ADMIN_API_KEY=replace-with-a-strong-admin-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.ecg.com

# Host port published by the API container
PUBLISHED_API_PORT=8000
